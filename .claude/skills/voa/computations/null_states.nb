       RowBox[{"0", ",", "1", ",", "z"}], "]"}], ",", 
      RowBox[{"ggwb", "[", 
       RowBox[{"0", ",", "1", ",", "z"}], "]"}]}], "}"}]}], ";"}], 
  RowBox[{"(*", "CNH", "*)"}]}], "\[IndentingNewLine]", 
