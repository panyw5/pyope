Cell[CellGroupData[{

Cell["Calculating the Physical States", "Section",
 CellChangeTimes->{{3.797123151860656*^9, 3.7971231598118134`*^9}, {
  3.80036349643441*^9, 3.8003634997068095`*^9}, {3.80036361233599*^9, 
  3.8003636151381354`*^9}},ExpressionUUID->"ad4567d3-2e72-4a45-baeb-\
1cd7aa6f72f1"],

Cell["\<\
In this section we give two separate calculations for the vacuum character of \
the VOA. The first gives a more refined character with 3 fugacities, while \
the second only 2 fugacities (their content is elaborated upon in the \
individual sections). It is important to note that the character is \
calculated on a level-by-level basis which has been set in the settings tab.\
\>", "Text",
 CellChangeTimes->{{3.8170122271702557`*^9, 3.817012292520432*^9}, {
   3.817012328295697*^9, 3.817012434803947*^9}, 
   3.8219561538571672`*^9},ExpressionUUID->"e2d49ac0-d90f-4984-829d-\
c896eb010d86"],

Cell[CellGroupData[{

Cell["R-Filtration Level-by-Level Character Calculator", "Subsection",
 CellChangeTimes->{{3.800363595901763*^9, 3.8003636064923687`*^9}, {
  3.8014647975845737`*^9, 3.8014648053433995`*^9}, {3.8014674105240445`*^9, 
  3.8014674164230113`*^9}},ExpressionUUID->"96b837f2-da72-4676-b5d0-\
bd3db9bf9f12"],

Cell["\<\
In this calculation the character comprises of 3 separate fugacities z, y and \
v. These correspond to gl(1) (osp(2|2)), R-filtration and gl(1) (outer \
automorphism) respectively. The fugacity corresponding to the sl(2) of \
osp(2|2) is neglected here since we are at a specific level in its expansion. \
 Note that due to this extra refinement this method of calculation of the \
character takes longer than the subsequent section.\
\>", "Text",
 CellChangeTimes->{{3.8170124656272306`*^9, 3.817012497953347*^9}, {
  3.8170126305902023`*^9, 3.817012665180109*^9}, {3.8170128877256727`*^9, 
  3.817012941042856*^9}, {3.821876845493395*^9, 3.821876848194268*^9}, {
  3.821876921588385*^9, 3.8218769653926163`*^9}, {3.821877211882989*^9, 
  3.8218772296845846`*^9}, {3.8218827038079166`*^9, 3.8218827859207945`*^9}, {
  3.821882818870654*^9, 3.8218828228849154`*^9}, {3.821883000467984*^9, 
  3.8218830549580493`*^9}},ExpressionUUID->"28e9ec8a-25bc-41f9-8f55-\
8ef0237f7202"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RedRemover", "[", 
   RowBox[{"g_", ",", "i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "char", ",", "dta", ",", "dta1", ",", 
      "sts", ",", "sts1", ",", "sts2", ",", "sm", ",", "css", ",", "smple", 
      ",", "sml", ",", "sml1", ",", "sml2", ",", "sml3", ",", "sml4"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dta", "=", 
      RowBox[{
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", "0"}], "]"}], "//", 
       "ExpandAll"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dta1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Fsort", "[", 
         RowBox[{"#", ",", "z"}], "]"}], "&"}], "/@", "dta"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"dta1", "[", 
              RowBox[{"[", "\[Mu]", "]"}], "]"}], "]"}], "===", "Plus"}], ",", 
           RowBox[{"List", "@@", 
            RowBox[{"dta1", "[", 
             RowBox[{"[", "\[Mu]", "]"}], "]"}]}], ",", 
           RowBox[{"dta1", "[", 
            RowBox[{"[", "\[Mu]", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", 
           RowBox[{"Length", "[", "dta1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sts1", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", 
               RowBox[{"sts", "[", 
                RowBox[{"[", "iii", "]"}], "]"}], "]"}], "===", "Times"}], 
             ",", 
             RowBox[{"List", "@@", 
              RowBox[{"sts", "[", 
               RowBox[{"[", "iii", "]"}], "]"}]}], ",", 
             RowBox[{"sts", "[", 
              RowBox[{"[", "iii", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"iii", ",", 
             RowBox[{"Length", "[", "sts", "]"}]}], "}"}]}], "]"}], "]"}], 
        ",", "_Integer"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sts2", "=", 
      RowBox[{"DeleteDuplicates", "[", "sts1", "]"}]}], ";", 
     "\[IndentingNewLine]", "sts2"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8014828990843554`*^9, 3.8014829628445587`*^9}, {
  3.801483044710611*^9, 3.801483044816328*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"3d5e87cf-146a-4420-883d-1f8f6821d3a7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rcounter", "[", "g_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "r1", ",", "r2", ",", "r3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{"y", "/.", 
       RowBox[{"Nl", "\[Rule]", "Times"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{"r1", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww1", "\[Rule]", "dww1"}], ",", 
         RowBox[{"ww2", "\[Rule]", "dww2"}], ",", 
         RowBox[{"jj0", "\[Rule]", "djj0"}], ",", 
         RowBox[{"wwb1", "\[Rule]", "dwwb1"}], ",", 
         RowBox[{"wwb2", "\[Rule]", "dwwb2"}], ",", 
         RowBox[{"tt", "\[Rule]", "dtt"}], ",", 
         RowBox[{"gg", "\[Rule]", "dgg"}], ",", 
         RowBox[{"ggt", "\[Rule]", "dggt"}], ",", 
         RowBox[{"ggw1", "\[Rule]", "dggw1"}], ",", 
         RowBox[{"ggwb1", "\[Rule]", "dggwb1"}], ",", 
         RowBox[{"ggw2", "\[Rule]", "dggw2"}], ",", 
         RowBox[{"ggwb2", "\[Rule]", "dggwb2"}], ",", 
         RowBox[{"oo", "\[Rule]", "doo"}], ",", 
         RowBox[{"ggo", "\[Rule]", "dggo"}], ",", 
         RowBox[{"ggto", "\[Rule]", "dggto"}], ",", 
         RowBox[{"xxo", "\[Rule]", "dxxo"}], ",", 
         RowBox[{"oob", "\[Rule]", "doob"}], ",", 
         RowBox[{"ggob", "\[Rule]", "dggob"}], ",", 
         RowBox[{"ggtob", "\[Rule]", "dggtob"}], ",", 
         RowBox[{"xxob", "\[Rule]", "dxxob"}], ",", 
         RowBox[{"uu", "\[Rule]", "duu"}], ",", 
         RowBox[{"ggu", "\[Rule]", "dggu"}], ",", 
         RowBox[{"ggub", "\[Rule]", "dggub"}], ",", 
         RowBox[{"xxu", "\[Rule]", "dxxu"}]}], "}"}]}]}], ";", 
     RowBox[{"(*", "CNH", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"rfiltotal", "[", "#", "]"}], "&"}], "/@", "r2"}]}], ";", 
     "\[IndentingNewLine]", "r3"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.8014834320080547`*^9, 3.801483474257329*^9}, {
   3.801483552094946*^9, 3.8014835717101803`*^9}, {3.8014836204527893`*^9, 
   3.8014836472768097`*^9}, {3.801483679830553*^9, 3.8014837369558516`*^9}, 
   3.801991961525973*^9, 3.8122851651064415`*^9, 3.8122885814651794`*^9, 
   3.8124399675927305`*^9, 3.8124402808639297`*^9, 3.8141778446204576`*^9, 
   3.8146028944153223`*^9, 3.814604994297187*^9, 3.814606419811255*^9, 
   3.81467886533626*^9, 3.817020543893489*^9},
 CellLabel->
  "In[182]:=",ExpressionUUID->"df03f888-9b81-41ed-adc4-793f8490e4cf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rlistcreator", "[", 
   RowBox[{"n_", ",", "list_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "list"}], ",", 
      RowBox[{"strt", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Min", "[", "y", "]"}]}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"strt", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"strt", ",", 
          RowBox[{"Position", "[", 
           RowBox[{"y", ",", "i"}], "]"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "strt"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8014838199008365`*^9, 3.8014839629162407`*^9}, {
   3.801484029515773*^9, 3.801484071225132*^9}, {3.801484140422743*^9, 
   3.801484140812701*^9}, 3.801484178002108*^9, {3.801484217957634*^9, 
   3.801484238195707*^9}, {3.8014843737196245`*^9, 3.801484376109753*^9}},
 CellLabel->
  "In[183]:=",ExpressionUUID->"d7678d19-365f-4d88-8d80-c7d8a2578ece"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RSingleCharCalculator", "[", 
   RowBox[{"g_", ",", "i_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "w", ",", "wrk", ",", "char", ",", "smb", 
      ",", "sm", ",", "css", ",", "smple", ",", "sml", ",", "sml1", ",", 
      "sml2", ",", "sml3", ",", "sml4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wrk", "=", 
      RowBox[{"Extract", "[", 
       RowBox[{"y", ",", 
        RowBox[{"rlistcreator", "[", 
         RowBox[{"n", ",", 
          RowBox[{"rcounter", "[", "y", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"smb", "=", 
      RowBox[{"wrk", "/.", 
       RowBox[{"Nl", "\[Rule]", "NO"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sm", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "jj", "]"}], 
          RowBox[{
          "smb", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"jj", ",", 
           RowBox[{"Length", "[", "wrk", "]"}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww1", "\[Rule]", "wwww1"}], ",", 
         RowBox[{"ww2", "\[Rule]", "wwww2"}], ",", 
         RowBox[{"jj0", "\[Rule]", "j0j0"}], ",", 
         RowBox[{"wwb1", "\[Rule]", "wbwb1"}], ",", 
         RowBox[{"wwb2", "\[Rule]", "wbwb2"}], ",", 
         RowBox[{"tt", "\[Rule]", "tttt"}], ",", 
         RowBox[{"gg", "\[Rule]", "gggg"}], ",", 
         RowBox[{"ggt", "\[Rule]", "gtgt"}], ",", 
         RowBox[{"ggw1", "\[Rule]", "gwgw1"}], ",", 
         RowBox[{"ggwb1", "\[Rule]", "gwbgwb1"}], ",", 
         RowBox[{"ggw2", "\[Rule]", "gwgw2"}], ",", 
         RowBox[{"ggwb2", "\[Rule]", "gwbgwb2"}], ",", 
         RowBox[{"oo", "\[Rule]", "oooo"}], ",", 
         RowBox[{"ggo", "\[Rule]", "gogo"}], ",", 
         RowBox[{"ggto", "\[Rule]", "gtogto"}], ",", 
         RowBox[{"xxo", "\[Rule]", "xoxo"}], ",", 
         RowBox[{"oob", "\[Rule]", "obob"}], ",", 
         RowBox[{"ggob", "\[Rule]", "gobgob"}], ",", 
         RowBox[{"ggtob", "\[Rule]", "gtobgtob"}], ",", 
         RowBox[{"xxob", "\[Rule]", "xobxob"}], ",", 
         RowBox[{"uu", "\[Rule]", "uuuu"}], ",", 
         RowBox[{"ggu", "\[Rule]", "gugu"}], ",", 
         RowBox[{"ggub", "\[Rule]", "gubgub"}], ",", 
         RowBox[{"xxu", "\[Rule]", "xuxu"}]}], "}"}]}]}], ";", 
     RowBox[{"(*", "CNH", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"smple", "=", 
      RowBox[{"GetCoefficients", "[", "sm", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"char", "=", 
      RowBox[{"MatrixRank", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{
             "smple", "\[LeftDoubleBracket]", "ll", "\[RightDoubleBracket]"}],
              ",", 
             RowBox[{"\[Alpha]", "[", "kk", "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"kk", ",", 
             RowBox[{"Length", "[", "wrk", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", 
           RowBox[{"Length", "[", "smple", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "char"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.814761819793337*^9, 3.8147841696675997`*^9, {3.8170205464860373`*^9, 
   3.817020561441346*^9}},
 CellLabel->
  "In[184]:=",ExpressionUUID->"e6b91923-5654-4b91-8782-33c6cbbee562"],

Cell[BoxData[
 RowBox[{
  RowBox[{"redsubtractor", "[", 
   RowBox[{"list_", ",", "flist_", ",", "ii_", ",", "jj_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "list"}], ",", "i", ",", "j", ",", 
      RowBox[{"res", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "list", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           ",", "Bold"}], "]"}], "[", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fcal", "===", 
               CheckboxBox[False]}], ",", "fcollectioncoloured", ",", 
              "sfcollectioncoloured"}], "]"}], "\[LeftDoubleBracket]", 
            RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{"NumericalSort", "[", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"rcounter", "[", 
               RowBox[{"flist", "\[LeftDoubleBracket]", 
                RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], "]"}], 
              "]"}], "]"}], "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}]}], "]"}], "]"}], "}"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"Length", "[", "y", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"res", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"res", ",", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"y", "\[LeftDoubleBracket]", 
               RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "-", 
              RowBox[{
              "y", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             ",", "Bold"}], "]"}], "[", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"fcal", "===", 
                 CheckboxBox[False]}], ",", "fcollectioncoloured", ",", 
                "sfcollectioncoloured"}], "]"}], "\[LeftDoubleBracket]", 
              RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], ",", 
             RowBox[{
              RowBox[{"NumericalSort", "[", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"rcounter", "[", 
                 RowBox[{"flist", "\[LeftDoubleBracket]", 
                  RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], "]"}],
                 "]"}], "]"}], "\[LeftDoubleBracket]", 
              RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
           "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "res"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.8019353414346046`*^9, 3.8019353949108424`*^9}, {
   3.8019363734134417`*^9, 3.801936438576553*^9}, {3.8019365016978025`*^9, 
