Cell[BoxData[
 RowBox[{"ansmodstart", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"EvenQ", "[", 
     RowBox[{"Length", "[", "mparam", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Length", "[", "mparam", "]"}], "/", "2"}], "+", "1"}], ",", 
    RowBox[{
