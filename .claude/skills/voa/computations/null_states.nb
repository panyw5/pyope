   3.821955519334176*^9, 3.821972453753152*^9, 3.822848298044536*^9, {
   3.822848614480372*^9, 
   3.822848717602878*^9}},ExpressionUUID->"fbd390bf-9984-4c83-a9ee-\
9e147751b9fd"],

Cell[TextData[{
 StyleBox["9.",
  FontWeight->"Bold"],
 " The output in the unrefined case is  similar to that of the previous step, \
up to the R-filtration grading, and given here for the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "3"], TraditionalForm]],ExpressionUUID->
  "cf2e4ad6-a6e7-4ee3-be94-61f8ae668a34"],
 "case at lev =3 :"
}], "Text",
