   3.821965612406345*^9}, {3.8219839226876593`*^9, 
   3.821983959160059*^9}},ExpressionUUID->"a1b64cea-52a2-45cd-bb90-\
472ab91713e4"],

Cell[TextData[{
 StyleBox["8.",
  FontWeight->"Bold"],
 " An example for the output of the above procedure in the refined case, and \
for the VOA corresponding to the complex reflection group ",
