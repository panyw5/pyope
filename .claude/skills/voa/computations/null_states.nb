Cell[BoxData[
 RowBox[{
  RowBox[{"FullCharCalculator", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "x"}], ",", "chartable"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"chartable", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{"SingleCharCalculator", "[", 
              RowBox[{"y", ",", "i", ",", "j"}], "]"}], ",", "Bold"}], "]"}], 
           "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fcal", "===", 
               CheckboxBox[False]}], ",", "fcollectioncoloured", ",", 
              "sfcollectioncoloured"}], "]"}], "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "y", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "y", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "chartable"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.814766780060512*^9, 3.8147667823459797`*^9}, {
   3.8147669497996798`*^9, 3.814766996077175*^9}, {3.8147687604144897`*^9, 
   3.814768768611487*^9}, {3.814770548536957*^9, 3.814770551611794*^9}, 
   3.814770936576206*^9, {3.81478016451068*^9, 3.8147802104811983`*^9}},
 CellLabel->
  "In[317]:=",ExpressionUUID->"33c3ad7d-3a6d-4c0f-b832-159fd3da1848"],

Cell[BoxData[
 RowBox[{"character", "=", 
  RowBox[{"Quiet", "[", 
   RowBox[{"FullCharCalculator", "[", 
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"fcal", "===", 
       CheckboxBox[False]}], ",", "fullgrouping", ",", "sfullgrouping"}], 
     "]"}], "]"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8003644542366705`*^9, 3.800364488505987*^9}, {
   3.8003645248633957`*^9, 3.800364532717179*^9}, {3.8003646009013567`*^9, 
   3.800364621980344*^9}, {3.8003677379864235`*^9, 3.800367760027877*^9}, {
   3.800368804731866*^9, 3.8003688075814314`*^9}, {3.801470678889282*^9, 
   3.801470687880168*^9}, {3.8014717362619658`*^9, 3.801471736666897*^9}, {
   3.8014718336345468`*^9, 3.801471834473343*^9}, {3.801917417270751*^9, 
   3.8019174175694575`*^9}, {3.8019388289501843`*^9, 
   3.8019388316470823`*^9}, {3.801939257125434*^9, 3.801939281697223*^9}, {
   3.814762131105445*^9, 3.814762156046158*^9}, {3.8147671183612833`*^9, 
   3.814767129360312*^9}, 3.814769899317045*^9, {3.814770554377564*^9, 
   3.8147705728412943`*^9}, {3.814780175319399*^9, 3.81478018211685*^9}, {
   3.814780213216023*^9, 3.814780214760751*^9}, {3.814857152825508*^9, 
   3.814857154487883*^9}},
 CellLabel->
