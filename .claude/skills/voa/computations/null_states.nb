Cell[BoxData[
 RowBox[{
  RowBox[{"rcounter", "[", "g_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "r1", ",", "r2", ",", "r3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{"y", "/.", 
       RowBox[{"Nl", "\[Rule]", "Times"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{"r1", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww", "\[Rule]", "dww"}], ",", 
         RowBox[{"jj0", "\[Rule]", "djj0"}], ",", 
         RowBox[{"wwb", "\[Rule]", "dwwb"}], ",", 
         RowBox[{"tt", "\[Rule]", "dtt"}], ",", 
         RowBox[{"gg", "\[Rule]", "dgg"}], ",", 
