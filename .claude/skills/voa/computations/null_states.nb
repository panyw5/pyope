Cell[BoxData[
 RowBox[{
  RowBox[{"RSingleCharCalculator", "[", 
   RowBox[{"g_", ",", "i_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "w", ",", "wrk", ",", "char", ",", "smb", 
      ",", "sm", ",", "css", ",", "smple", ",", "sml", ",", "sml1", ",", 
      "sml2", ",", "sml3", ",", "sml4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wrk", "=", 
      RowBox[{"Extract", "[", 
       RowBox[{"y", ",", 
        RowBox[{"rlistcreator", "[", 
         RowBox[{"n", ",", 
          RowBox[{"rcounter", "[", "y", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"smb", "=", 
      RowBox[{"wrk", "/.", 
       RowBox[{"Nl", "\[Rule]", "NO"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sm", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "jj", "]"}], 
          RowBox[{
          "smb", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"jj", ",", 
           RowBox[{"Length", "[", "wrk", "]"}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww", "\[Rule]", "wwww"}], ",", 
         RowBox[{"jj0", "\[Rule]", "j0j0"}], ",", 
         RowBox[{"wwb", "\[Rule]", "wbwb"}], ",", 
         RowBox[{"tt", "\[Rule]", "tttt"}], ",", 
         RowBox[{"gg", "\[Rule]", "gggg"}], ",", 
         RowBox[{"ggt", "\[Rule]", "gtgt"}], ",", 
         RowBox[{"ggw", "\[Rule]", "gwgw"}], ",", 
         RowBox[{"ggwb", "\[Rule]", "gwbgwb"}]}], "}"}]}]}], ";", 
     RowBox[{"(*", "CNH", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"smple", "=", 
      RowBox[{"GetCoefficients", "[", "sm", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"char", "=", 
      RowBox[{"MatrixRank", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{
             "smple", "\[LeftDoubleBracket]", "ll", "\[RightDoubleBracket]"}],
              ",", 
             RowBox[{"\[Alpha]", "[", "kk", "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"kk", ",", 
             RowBox[{"Length", "[", "wrk", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", 
           RowBox[{"Length", "[", "smple", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "char"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
