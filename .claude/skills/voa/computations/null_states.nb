Cell[CellGroupData[{

Cell["Level", "Subsection",
 CellChangeTimes->{{3.7971122356165667`*^9, 3.797112237095779*^9}, {
  3.800662406645771*^9, 3.800662406750491*^9}, {3.80066574725276*^9, 
  3.8006657473325467`*^9}, {3.8006690433339376`*^9, 3.8006690433748293`*^9}, {
  3.801398293976142*^9, 
  3.801398299645203*^9}},ExpressionUUID->"c7218db0-6824-419a-a976-\
d5f9dcabfdbb"],

Cell["\<\
In this section we employ the definitions set in the previous sections and \
generate all the possible field combinations at a level. This is done by \
generating all integer partitions and then allocating them to specific \
fields. The answer we end up with is a list of normal ordered products of \
fields and their derivatives.\
\>", "Text",
 CellChangeTimes->{{3.816930257546608*^9, 3.816930352187307*^9}, {
  3.816930548194685*^9, 
  3.816930548503007*^9}},ExpressionUUID->"3e00f60c-b290-4b01-9b4d-\
541177e204c5"],

Cell[BoxData[
 RowBox[{"part", "=", 
  RowBox[{
   RowBox[{"1", "/", "2"}], 
   RowBox[{"IntegerPartitions", "[", 
    RowBox[{"2", " ", "lev"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.797112272239448*^9, 3.797112277246871*^9}},
 CellLabel->
  "In[136]:=",ExpressionUUID->"7a63e080-3494-4528-ac56-5a67d7156ed7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"generated", "=", 
   RowBox[{
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"GenOp", "[", "part", "]"}], ",", " ", 
      RowBox[{
       RowBox[{"!", 
        RowBox[{"NumberQ", "[", "#", "]"}]}], "&"}]}], "]"}], "/.", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "*", "x_"}], ":>", "x"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DeleteDuplicates", "[", "%", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"finalgen", "=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Head", "[", 
        RowBox[{"%", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
        "]"}], "===", "NO"}], ",", 
      RowBox[{"ReplaceAll", "[", 
       RowBox[{
        RowBox[{"%", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{"NO", "\[Rule]", "Nl"}]}], "]"}], ",", 
      RowBox[{"Nl", "[", 
       RowBox[{"%", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
       "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"i", ",", 
      RowBox[{"Length", "[", "%", "]"}]}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.797112306494431*^9, 3.7971123091597157`*^9}, {
   3.7971130299830713`*^9, 3.797113031964904*^9}, {3.8006616362247105`*^9, 
   3.800661637937237*^9}, {3.8006669979655375`*^9, 3.800667000799982*^9}, 
   3.8014072315040708`*^9, {3.8014699516815786`*^9, 3.801469958596914*^9}, {
