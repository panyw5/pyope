Cell[CellGroupData[{

Cell["Calculating the Physical States", "Section",
 CellChangeTimes->{{3.797123151860656*^9, 3.7971231598118134`*^9}, {
  3.80036349643441*^9, 3.8003634997068095`*^9}, {3.80036361233599*^9, 
  3.8003636151381354`*^9}},ExpressionUUID->"265c8031-16d5-4e2c-9f57-\
efba7cab1858"],

Cell["\<\
In this section we give two separate calculations for the vacuum character of \
the VOA. The first gives a more refined character with 3 fugacities, while \
the second only 2 fugacities (their content is elaborated upon in the \
individual sections). It is important to note that the character is \
calculated on a level-by-level basis which has been set in the settings tab.\
\>", "Text",
 CellChangeTimes->{{3.8170122271702557`*^9, 3.817012292520432*^9}, {
  3.817012328295697*^9, 3.817012434803947*^9}, {3.8219561096438417`*^9, 
  3.821956111197184*^9}},ExpressionUUID->"86990701-0bbb-4f20-8ad9-\
d76b6e2f26aa"],

Cell[CellGroupData[{

Cell["R-Filtration Level-by-Level Character Calculator", "Subsection",
 CellChangeTimes->{{3.800363595901763*^9, 3.8003636064923687`*^9}, {
  3.8014647975845737`*^9, 3.8014648053433995`*^9}, {3.8014674105240445`*^9, 
  3.8014674164230113`*^9}},ExpressionUUID->"62d6c96b-d1fc-4282-a60f-\
bd949729299b"],

Cell["\<\
In this calculation the character comprises of 3 separate fugacities z, y and \
v. These correspond to gl(1) (osp(2|2)), R-filtration and gl(1) (outer \
automorphism) respectively. The fugacity corresponding to the sl(2) of \
osp(2|2) is neglected here since we are at a specific level in its expansion. \
 Note that due to this extra refinement this method of calculation of the \
character takes longer than the subsequent section.\
\>", "Text",
 CellChangeTimes->{{3.8170124656272306`*^9, 3.817012497953347*^9}, {
  3.8170126305902023`*^9, 3.817012665180109*^9}, {3.8170128877256727`*^9, 
  3.817012941042856*^9}, {3.821876845493395*^9, 3.821876848194268*^9}, {
  3.821876921588385*^9, 3.8218769653926163`*^9}, {3.821877211882989*^9, 
  3.8218772296845846`*^9}, {3.8218827038079166`*^9, 3.8218827859207945`*^9}, {
  3.821882818870654*^9, 3.8218828228849154`*^9}, {3.821883000467984*^9, 
  3.8218830549580493`*^9}},ExpressionUUID->"9d32e18b-a783-4b8b-9ca4-\
1db735658708"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RedRemover", "[", 
   RowBox[{"g_", ",", "i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "char", ",", "dta", ",", "dta1", ",", 
      "sts", ",", "sts1", ",", "sts2", ",", "sm", ",", "css", ",", "smple", 
      ",", "sml", ",", "sml1", ",", "sml2", ",", "sml3", ",", "sml4"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dta", "=", 
      RowBox[{
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", "0"}], "]"}], "//", 
       "ExpandAll"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dta1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Fsort", "[", 
         RowBox[{"#", ",", "z"}], "]"}], "&"}], "/@", "dta"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"dta1", "[", 
              RowBox[{"[", "\[Mu]", "]"}], "]"}], "]"}], "===", "Plus"}], ",", 
           RowBox[{"List", "@@", 
            RowBox[{"dta1", "[", 
             RowBox[{"[", "\[Mu]", "]"}], "]"}]}], ",", 
           RowBox[{"dta1", "[", 
            RowBox[{"[", "\[Mu]", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", 
           RowBox[{"Length", "[", "dta1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sts1", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", 
               RowBox[{"sts", "[", 
                RowBox[{"[", "iii", "]"}], "]"}], "]"}], "===", "Times"}], 
             ",", 
             RowBox[{"List", "@@", 
              RowBox[{"sts", "[", 
               RowBox[{"[", "iii", "]"}], "]"}]}], ",", 
             RowBox[{"sts", "[", 
              RowBox[{"[", "iii", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"iii", ",", 
             RowBox[{"Length", "[", "sts", "]"}]}], "}"}]}], "]"}], "]"}], 
        ",", "_Integer"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sts2", "=", 
      RowBox[{"DeleteDuplicates", "[", "sts1", "]"}]}], ";", 
     "\[IndentingNewLine]", "sts2"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8014828990843554`*^9, 3.8014829628445587`*^9}, {
  3.801483044710611*^9, 3.801483044816328*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"686d94f3-9cfd-4082-80a1-e2bf3e051d4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rcounter", "[", "g_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "r1", ",", "r2", ",", "r3"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"r1", "=", 
      RowBox[{"y", "/.", 
       RowBox[{"Nl", "\[Rule]", "Times"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"r2", "=", 
      RowBox[{"r1", "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww", "\[Rule]", "dww"}], ",", 
         RowBox[{"jj0", "\[Rule]", "djj0"}], ",", 
         RowBox[{"wwb", "\[Rule]", "dwwb"}], ",", 
         RowBox[{"tt", "\[Rule]", "dtt"}], ",", 
         RowBox[{"gg", "\[Rule]", "dgg"}], ",", 
         RowBox[{"ggt", "\[Rule]", "dggt"}], ",", 
         RowBox[{"ggw", "\[Rule]", "dggw"}], ",", 
         RowBox[{"ggwb", "\[Rule]", "dggwb"}]}], "}"}]}]}], ";", 
     RowBox[{"(*", "CNH", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"r3", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"rfiltotal", "[", "#", "]"}], "&"}], "/@", "r2"}]}], ";", 
     "\[IndentingNewLine]", "r3"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.8014834320080547`*^9, 3.801483474257329*^9}, {
   3.801483552094946*^9, 3.8014835717101803`*^9}, {3.8014836204527893`*^9, 
   3.8014836472768097`*^9}, {3.801483679830553*^9, 3.8014837369558516`*^9}, 
   3.801991961525973*^9, 3.8170195937741747`*^9},
 CellLabel->
  "In[186]:=",ExpressionUUID->"a42ef620-a41e-451d-8efe-0bc3f35da142"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rlistcreator", "[", 
   RowBox[{"n_", ",", "list_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "list"}], ",", 
      RowBox[{"strt", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Min", "[", "y", "]"}]}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"strt", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"strt", ",", 
          RowBox[{"Position", "[", 
           RowBox[{"y", ",", "i"}], "]"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "strt"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8014838199008365`*^9, 3.8014839629162407`*^9}, {
   3.801484029515773*^9, 3.801484071225132*^9}, {3.801484140422743*^9, 
   3.801484140812701*^9}, 3.801484178002108*^9, {3.801484217957634*^9, 
   3.801484238195707*^9}, {3.8014843737196245`*^9, 3.801484376109753*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"648b81d5-f82b-449f-876c-196b11ea0063"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RSingleCharCalculator", "[", 
   RowBox[{"g_", ",", "i_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "w", ",", "wrk", ",", "char", ",", "smb", 
      ",", "sm", ",", "css", ",", "smple", ",", "sml", ",", "sml1", ",", 
      "sml2", ",", "sml3", ",", "sml4"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"wrk", "=", 
      RowBox[{"Extract", "[", 
       RowBox[{"y", ",", 
        RowBox[{"rlistcreator", "[", 
         RowBox[{"n", ",", 
          RowBox[{"rcounter", "[", "y", "]"}]}], "]"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"smb", "=", 
      RowBox[{"wrk", "/.", 
       RowBox[{"Nl", "\[Rule]", "NO"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sm", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "jj", "]"}], 
          RowBox[{
          "smb", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"jj", ",", 
           RowBox[{"Length", "[", "wrk", "]"}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww", "\[Rule]", "wwww"}], ",", 
         RowBox[{"jj0", "\[Rule]", "j0j0"}], ",", 
         RowBox[{"wwb", "\[Rule]", "wbwb"}], ",", 
         RowBox[{"tt", "\[Rule]", "tttt"}], ",", 
         RowBox[{"gg", "\[Rule]", "gggg"}], ",", 
         RowBox[{"ggt", "\[Rule]", "gtgt"}], ",", 
         RowBox[{"ggw", "\[Rule]", "gwgw"}], ",", 
         RowBox[{"ggwb", "\[Rule]", "gwbgwb"}]}], "}"}]}]}], ";", 
     RowBox[{"(*", "CNH", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"smple", "=", 
      RowBox[{"GetCoefficients", "[", "sm", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"char", "=", 
      RowBox[{"MatrixRank", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{
             "smple", "\[LeftDoubleBracket]", "ll", "\[RightDoubleBracket]"}],
              ",", 
             RowBox[{"\[Alpha]", "[", "kk", "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"kk", ",", 
             RowBox[{"Length", "[", "wrk", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", 
           RowBox[{"Length", "[", "smple", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "char"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{
  3.814761819793337*^9, {3.8163645317595167`*^9, 3.81636454593548*^9}, {
   3.817012832680139*^9, 3.8170128530048237`*^9}, 3.8170136793438396`*^9, 
   3.8170195966453648`*^9},
 CellLabel->
  "In[188]:=",ExpressionUUID->"46463e4b-3b95-407b-94b7-068460569a68"],

Cell[BoxData[
 RowBox[{
  RowBox[{"redsubtractor", "[", 
   RowBox[{"list_", ",", "flist_", ",", "ii_", ",", "jj_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "list"}], ",", "i", ",", "j", ",", 
      RowBox[{"res", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{
           RowBox[{
           "list", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           ",", "Bold"}], "]"}], "[", 
         RowBox[{"Append", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"fcal", "===", 
               CheckboxBox[False]}], ",", "fcollectioncoloured", ",", 
              "sfcollectioncoloured"}], "]"}], "\[LeftDoubleBracket]", 
            RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], ",", 
           RowBox[{
            RowBox[{"NumericalSort", "[", 
             RowBox[{"DeleteDuplicates", "[", 
              RowBox[{"rcounter", "[", 
               RowBox[{"flist", "\[LeftDoubleBracket]", 
                RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], "]"}], 
              "]"}], "]"}], "\[LeftDoubleBracket]", "1", 
            "\[RightDoubleBracket]"}]}], "]"}], "]"}], "}"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"Length", "[", "y", "]"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"res", "=", 
        RowBox[{"Append", "[", 
         RowBox[{"res", ",", 
          RowBox[{
           RowBox[{"Style", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"y", "\[LeftDoubleBracket]", 
               RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}], "-", 
              RowBox[{
              "y", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             ",", "Bold"}], "]"}], "[", 
           RowBox[{"Append", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"fcal", "===", 
                 CheckboxBox[False]}], ",", "fcollectioncoloured", ",", 
                "sfcollectioncoloured"}], "]"}], "\[LeftDoubleBracket]", 
              RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], ",", 
             RowBox[{
              RowBox[{"NumericalSort", "[", 
               RowBox[{"DeleteDuplicates", "[", 
                RowBox[{"rcounter", "[", 
                 RowBox[{"flist", "\[LeftDoubleBracket]", 
                  RowBox[{"ii", ",", "jj"}], "\[RightDoubleBracket]"}], "]"}],
                 "]"}], "]"}], "\[LeftDoubleBracket]", 
              RowBox[{"i", "+", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
           "]"}]}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", "res"}]}], 
   "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.8019353414346046`*^9, 3.8019353949108424`*^9}, {
   3.8019363734134417`*^9, 3.801936438576553*^9}, {3.8019365016978025`*^9, 
   3.801936512919733*^9}, {3.8019365432674513`*^9, 3.8019365836407967`*^9}, {
   3.801936850037933*^9, 3.801936850332158*^9}, {3.8019368862022257`*^9, 
   3.801936896487166*^9}, {3.8019370183543887`*^9, 3.8019370208892527`*^9}, {
   3.8019372593366947`*^9, 3.801937271199567*^9}, {3.801937455477779*^9, 
   3.801937477587243*^9}, {3.801937652276842*^9, 3.8019376890387545`*^9}, {
   3.8019377316025653`*^9, 3.801937735904771*^9}, 3.8019381368450766`*^9, {
   3.801938264926977*^9, 3.8019382685689173`*^9}, {3.801943228910251*^9, 
   3.8019432626904554`*^9}, {3.814770889081942*^9, 3.814770890673148*^9}, 
   3.81478011708739*^9, {3.8147801904074917`*^9, 3.8147802017216053`*^9}, 
   3.814780532747341*^9},
 CellLabel->
  "In[189]:=",ExpressionUUID->"990b330b-4313-439b-9df6-fd19134e4bea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"RFullCharCalculator", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "x"}], ",", "chart", ",", "chartable"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"chart", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"rcounter", "[", 
                 RowBox[{"y", "\[LeftDoubleBracket]", 
                  RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
                ",", "k"}], "]"}], ",", 
              RowBox[{"RSingleCharCalculator", "[", 
               RowBox[{
                RowBox[{"RedRemover", "[", 
                 RowBox[{"y", ",", "i", ",", "j"}], "]"}], ",", "i", ",", 
                "k"}], "]"}], ",", "Nothing"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Min", "[", 
               RowBox[{"rcounter", "[", 
                RowBox[{"y", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
               "]"}], ",", 
              RowBox[{"Max", "[", 
               RowBox[{"rcounter", "[", 
                RowBox[{"y", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
               "]"}], ",", 
              FractionBox["1", "2"]}], "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"j", ",", 
            RowBox[{"Length", "[", 
             RowBox[{
             "y", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "y", "]"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
