Cell[BoxData[
 RowBox[{
  RowBox[{"rlistcreator", "[", 
   RowBox[{"n_", ",", "list_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "list"}], ",", 
      RowBox[{"strt", "=", 
       RowBox[{"{", "}"}]}], ",", "i"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", 
        RowBox[{"Min", "[", "y", "]"}]}], ",", 
       RowBox[{"i", "<", 
        RowBox[{"n", "+", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"strt", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"strt", ",", 
          RowBox[{"Position", "[", 
           RowBox[{"y", ",", "i"}], "]"}]}], "]"}]}]}], "]"}], ";", 
     "\[IndentingNewLine]", "strt"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
