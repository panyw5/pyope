Cell[BoxData[
 RowBox[{"rfcharacter", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"fcal", "===", 
     CheckboxBox[False]}], ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fermlist", "\[LeftDoubleBracket]", 
         RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", " ", 
