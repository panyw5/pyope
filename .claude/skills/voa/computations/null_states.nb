Cell[TextData[{
 "Ticking the above box  speeds up the code by not searching for the \
degeneracies of the negatively charged-states (under the VOA symmetries). \
Calculating that part of the spectrum is very intensive, but it can be gotten \
from the positively-charged states by conjugation.\[CloseCurlyDoubleQuote]",
 Cell[BoxData[
  CheckboxBox[False]],
  CellChangeTimes->{{3.8013975367885885`*^9, 3.8013975702809114`*^9}, {
