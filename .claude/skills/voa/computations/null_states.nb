Cell[BoxData[
 RowBox[{
  RowBox[{"pwrexpand", "[", "x_", "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "x"}], ",", 
      RowBox[{"list", "=", 
       RowBox[{"{", "}"}]}], ",", "i", ",", "j", ",", 
      RowBox[{"p", "=", 
       RowBox[{"Variables", "[", "x", "]"}]}]}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"i", "=", "1"}], ",", 
       RowBox[{"i", "<", 
        RowBox[{
         RowBox[{"Length", "[", "p", "]"}], "+", "1"}]}], ",", 
       RowBox[{"i", "++"}], ",", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"j", "=", "1"}], ",", 
         RowBox[{"j", "<", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"Exponent", "[", 
             RowBox[{"y", ",", 
              RowBox[{
              "p", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             "]"}], "+", "1"}], ")"}]}], ",", 
         RowBox[{"j", "++"}], ",", 
         RowBox[{"list", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"list", ",", 
            RowBox[{"Head", "[", 
             RowBox[{
             "p", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], 
             "]"}]}], "]"}]}]}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "list"}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellLabel->
  "In[357]:=",ExpressionUUID->"b79026c4-935a-4622-a59e-f3f5c45da3a3"],

