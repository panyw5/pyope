Cell[BoxData[
 RowBox[{
  RowBox[{"flt1", "[", "x_", "]"}], ":=", "\[IndentingNewLine]", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"uuu", "=", "x"}], ",", "k", ",", "l", ",", "j", ",", "i"}], 
     "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"l", "=", "1"}], ",", 
       RowBox[{"l", "<", 
        RowBox[{
         RowBox[{"Length", "[", "uuu", "]"}], "+", "1"}]}], ",", 
       RowBox[{"l", "++"}], ",", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "<", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{
            "uuu", "\[LeftDoubleBracket]", "l", "\[RightDoubleBracket]"}], 
            "]"}], "+", "1"}]}], ",", 
         RowBox[{"k", "++"}], ",", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"j", "=", "1"}], ",", 
           RowBox[{"j", "<", 
            RowBox[{
             RowBox[{"Length", "[", 
              RowBox[{"uuu", "\[LeftDoubleBracket]", 
               RowBox[{"l", ",", "k"}], "\[RightDoubleBracket]"}], "]"}], "+",
              "1"}]}], ",", 
           RowBox[{"j", "++"}], ",", 
           RowBox[{"For", "[", 
            RowBox[{
             RowBox[{"i", "=", "1"}], ",", 
             RowBox[{
              RowBox[{"Length", "[", 
               RowBox[{"uuu", "\[LeftDoubleBracket]", 
                RowBox[{"l", ",", "k", ",", "j"}], "\[RightDoubleBracket]"}], 
               "]"}], "==", "1"}], ",", 
             RowBox[{"i", "++"}], ",", 
             RowBox[{
              RowBox[{"uuu", "\[LeftDoubleBracket]", 
               RowBox[{"l", ",", "k", ",", "j"}], "\[RightDoubleBracket]"}], 
              "=", 
              RowBox[{"Flatten", "[", 
               RowBox[{
                RowBox[{"uuu", "\[LeftDoubleBracket]", 
                 RowBox[{"l", ",", "k", ",", "j"}], "\[RightDoubleBracket]"}],
                 ",", "1"}], "]"}]}]}], "]"}]}], "]"}]}], "]"}]}], "]"}], ";",
      "\[IndentingNewLine]", "uuu"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellLabel->
