Cell[BoxData[
 RowBox[{
  RowBox[{"RedRemover", "[", 
   RowBox[{"g_", ",", "i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "char", ",", "dta", ",", "dta1", ",", 
      "sts", ",", "sts1", ",", "sts2", ",", "sm", ",", "css", ",", "smple", 
      ",", "sml", ",", "sml1", ",", "sml2", ",", "sml3", ",", "sml4"}], "}"}],
     ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dta", "=", 
      RowBox[{
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", "0"}], "]"}], "//", 
       "ExpandAll"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dta1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Fsort", "[", 
         RowBox[{"#", ",", "z"}], "]"}], "&"}], "/@", "dta"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"dta1", "[", 
              RowBox[{"[", "\[Mu]", "]"}], "]"}], "]"}], "===", "Plus"}], ",", 
           RowBox[{"List", "@@", 
            RowBox[{"dta1", "[", 
             RowBox[{"[", "\[Mu]", "]"}], "]"}]}], ",", 
           RowBox[{"dta1", "[", 
            RowBox[{"[", "\[Mu]", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", 
           RowBox[{"Length", "[", "dta1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sts1", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", 
               RowBox[{"sts", "[", 
                RowBox[{"[", "iii", "]"}], "]"}], "]"}], "===", "Times"}], 
             ",", 
             RowBox[{"List", "@@", 
              RowBox[{"sts", "[", 
               RowBox[{"[", "iii", "]"}], "]"}]}], ",", 
             RowBox[{"sts", "[", 
              RowBox[{"[", "iii", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"iii", ",", 
             RowBox[{"Length", "[", "sts", "]"}]}], "}"}]}], "]"}], "]"}], 
        ",", "_Integer"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sts2", "=", 
      RowBox[{"DeleteDuplicates", "[", "sts1", "]"}]}], ";", 
     "\[IndentingNewLine]", "sts2"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
