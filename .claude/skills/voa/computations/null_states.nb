Cell["\<\
This is using a specific grading for the character: fugacity z is for the \
gl(1) (in osp(2|2)), y is for the R (from the R-filtration) and v is  for the \
outer automorphism of the VOA.\
\>", "Text",
 CellChangeTimes->{{3.814859107072114*^9, 3.81485917674927*^9}, {
  3.814859293643738*^9, 3.814859294417242*^9}, {3.814859408678198*^9, 
  3.814859426071282*^9}, {3.814859511481937*^9, 3.814859529114072*^9}, {
  3.8218831328855686`*^9, 3.821883138561966*^9}, {3.821883216037249*^9, 
  3.821883226441781*^9}},ExpressionUUID->"73fba181-2b04-4048-9b34-\
8929035505d0"]
}, Closed]],

Cell[CellGroupData[{

Cell["Level-by-Level Character Calculator", "Subsection",
 CellChangeTimes->{{3.800363595901763*^9, 3.8003636064923687`*^9}, 
   3.817020513925705*^9},ExpressionUUID->"f547cfb2-0cf5-470d-9688-\
a6cf20d9bc87"],

Cell["\<\
In this calculation the character comprises of 2 separate fugacities z and v. \
These correspond to gl(1) (osp(2|2)) and gl(1) (outer automorphism) \
respectively. The fugacity corresponding to the sl(2) of osp(2|2) is \
neglected here since we are at a specific level in its expansion. \
\>", "Text",
 CellChangeTimes->{{3.8170129774663143`*^9, 3.817013015786317*^9}, {
  3.8218830699049892`*^9, 
  3.821883084122277*^9}},ExpressionUUID->"b73e7e7f-c3ba-4857-ac7d-\
bcb401e36ac8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"SingleCharCalculator", "[", 
   RowBox[{"g_", ",", "i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "g"}], ",", "char", ",", "dta", ",", "dta1", ",", 
      "sts", ",", "sts1", ",", "sts2", ",", "smb", ",", "sm", ",", "css", ",",
       "smple", ",", "sml", ",", "sml1", ",", "sml2", ",", "sml3", ",", 
      "sml4", ",", "bsm", ",", "aftope"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dta", "=", 
      RowBox[{
       RowBox[{"DeleteCases", "[", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], ",", "0"}], "]"}], "//", 
       "ExpandAll"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"dta1", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"Fsort", "[", 
         RowBox[{"#", ",", "z"}], "]"}], "&"}], "/@", "dta"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"sts", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", 
             RowBox[{"dta1", "[", 
              RowBox[{"[", "\[Mu]", "]"}], "]"}], "]"}], "===", "Plus"}], ",", 
           RowBox[{"List", "@@", 
            RowBox[{"dta1", "[", 
             RowBox[{"[", "\[Mu]", "]"}], "]"}]}], ",", 
           RowBox[{"dta1", "[", 
            RowBox[{"[", "\[Mu]", "]"}], "]"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", 
           RowBox[{"Length", "[", "dta1", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"sts1", "=", 
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"Head", "[", 
               RowBox[{"sts", "[", 
                RowBox[{"[", "iii", "]"}], "]"}], "]"}], "===", "Times"}], 
             ",", 
             RowBox[{"List", "@@", 
              RowBox[{"sts", "[", 
               RowBox[{"[", "iii", "]"}], "]"}]}], ",", 
             RowBox[{"sts", "[", 
              RowBox[{"[", "iii", "]"}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"iii", ",", 
             RowBox[{"Length", "[", "sts", "]"}]}], "}"}]}], "]"}], "]"}], 
        ",", "_Integer"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sts2", "=", 
      RowBox[{"DeleteDuplicates", "[", "sts1", "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"smb", "=", 
      RowBox[{"sts2", "/.", 
       RowBox[{"Nl", "\[Rule]", "NO"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sm", "=", 
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Alpha]", "[", "jj", "]"}], 
          RowBox[{
          "smb", "\[LeftDoubleBracket]", "jj", "\[RightDoubleBracket]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"jj", ",", 
           RowBox[{"Length", "[", "sts2", "]"}]}], "}"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"ww1", "\[Rule]", "wwww1"}], ",", 
         RowBox[{"ww2", "\[Rule]", "wwww2"}], ",", 
         RowBox[{"jj0", "\[Rule]", "j0j0"}], ",", 
         RowBox[{"wwb1", "\[Rule]", "wbwb1"}], ",", 
         RowBox[{"wwb2", "\[Rule]", "wbwb2"}], ",", 
         RowBox[{"tt", "\[Rule]", "tttt"}], ",", 
         RowBox[{"gg", "\[Rule]", "gggg"}], ",", 
         RowBox[{"ggt", "\[Rule]", "gtgt"}], ",", 
         RowBox[{"ggw1", "\[Rule]", "gwgw1"}], ",", 
         RowBox[{"ggwb1", "\[Rule]", "gwbgwb1"}], ",", 
         RowBox[{"ggw2", "\[Rule]", "gwgw2"}], ",", 
         RowBox[{"ggwb2", "\[Rule]", "gwbgwb2"}], ",", 
         RowBox[{"oo", "\[Rule]", "oooo"}], ",", 
         RowBox[{"ggo", "\[Rule]", "gogo"}], ",", 
         RowBox[{"ggto", "\[Rule]", "gtogto"}], ",", 
         RowBox[{"xxo", "\[Rule]", "xoxo"}], ",", 
         RowBox[{"oob", "\[Rule]", "obob"}], ",", 
         RowBox[{"ggob", "\[Rule]", "gobgob"}], ",", 
         RowBox[{"ggtob", "\[Rule]", "gtobgtob"}], ",", 
         RowBox[{"xxob", "\[Rule]", "xobxob"}], ",", 
         RowBox[{"uu", "\[Rule]", "uuuu"}], ",", 
         RowBox[{"ggu", "\[Rule]", "gugu"}], ",", 
         RowBox[{"ggub", "\[Rule]", "gubgub"}], ",", 
         RowBox[{"xxu", "\[Rule]", "xuxu"}]}], "}"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"smple", "=", 
      RowBox[{"GetCoefficients", "[", "sm", "]"}]}], ";", 
     RowBox[{"(*", "CNH", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"char", "=", 
      RowBox[{"MatrixRank", "[", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Coefficient", "[", 
            RowBox[{
             RowBox[{
             "smple", "\[LeftDoubleBracket]", "ll", "\[RightDoubleBracket]"}],
              ",", 
             RowBox[{"\[Alpha]", "[", "kk", "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"kk", ",", 
             RowBox[{"Length", "[", "sts1", "]"}]}], "}"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ll", ",", 
           RowBox[{"Length", "[", "smple", "]"}]}], "}"}]}], "]"}], "]"}]}], 
     ";", "\[IndentingNewLine]", "char"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.800363657530053*^9, 3.800363871176147*^9}, {
   3.800363984391412*^9, 3.80036406179634*^9}, {3.8003640935084224`*^9, 
   3.8003641705417852`*^9}, {3.800369785677356*^9, 3.8003697870891542`*^9}, {
   3.8006635132591777`*^9, 3.8006635184040923`*^9}, {3.8006636973532867`*^9, 
   3.8006637414926004`*^9}, {3.800663924566421*^9, 3.800663944532692*^9}, {
   3.800664090822212*^9, 3.800664107602478*^9}, {3.8006643188927565`*^9, 
   3.800664420410616*^9}, {3.800664651939963*^9, 3.800664660730036*^9}, {
   3.8006647140738544`*^9, 3.8006647261072817`*^9}, 3.800664775123621*^9, {
   3.80066484602512*^9, 3.800664857395813*^9}, {3.8006649399701676`*^9, 
   3.8006649562926555`*^9}, {3.8006650020970573`*^9, 3.800665007650749*^9}, {
   3.8006650655000296`*^9, 3.800665085581995*^9}, {3.8006652397350965`*^9, 
   3.800665278888715*^9}, {3.800665408294259*^9, 3.80066541626651*^9}, {
   3.800665491954259*^9, 3.8006655045556755`*^9}, {3.8006656200308876`*^9, 
   3.8006656427443466`*^9}, {3.800665689133172*^9, 3.8006657299518657`*^9}, {
   3.8146858401869173`*^9, 3.814685873368972*^9}, {3.8146859290308533`*^9, 
   3.814685969434895*^9}, {3.814686155728747*^9, 3.814686155884508*^9}, {
   3.8146862952245483`*^9, 3.8146863106327343`*^9}, {3.81468646965254*^9, 
   3.814686483390267*^9}, {3.81468652197267*^9, 3.814686555552967*^9}, 
   3.814761879434574*^9, {3.814762282939673*^9, 3.8147622832003727`*^9}, {
   3.814762317731192*^9, 3.814762341256503*^9}, {3.814762401265172*^9, 
   3.814762401559211*^9}, {3.814762601788597*^9, 3.8147626041870747`*^9}, {
   3.814769526261524*^9, 3.8147695310839653`*^9}, {3.8147696183632603`*^9, 
   3.814769618508005*^9}, {3.8147705404021063`*^9, 3.814770542929379*^9}, {
