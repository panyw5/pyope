Cell["\<\
The bold number is the degeneracy; inside the square brackets are the quantum \
numbers: red is for m (gl(1) in osp(2|2)), while blue is for r (gl(1) outer \
automorphism).\
\>", "Text",
 CellChangeTimes->{{3.801917426301194*^9, 3.8019175186351423`*^9}, {
   3.814859728442419*^9, 3.81485976771483*^9}, {3.814859982112124*^9, 
   3.814859982701168*^9}, 3.821877237843051*^9, {3.821877418269273*^9, 
   3.8218774495626554`*^9}},ExpressionUUID->"948a149c-7046-4f4f-8415-\
57034bba59ad"],

Cell[BoxData[
 RowBox[{"fcharacter", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"fcal", "===", 
     CheckboxBox[False]}], ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"fermlist", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", 
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"character", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
          "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
         SuperscriptBox["z", 
          RowBox[{"character", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "1", ",", "1", ",", "1"}], 
           "\[RightDoubleBracket]"}]], 
         SuperscriptBox["v", 
          RowBox[{"character", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "1", ",", "2", ",", "1"}], 
           "\[RightDoubleBracket]"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "character", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", 
           RowBox[{
           "character", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], "/.", " ", 
      RowBox[{
       RowBox[{"MatrixRank", "[", 
        RowBox[{"{", "}"}], "]"}], "\[Rule]", "0"}]}], "]"}], ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sfermlist", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", 
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"character", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
           "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
          SuperscriptBox["z", 
           RowBox[{"character", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j", ",", "1", ",", "1", ",", "1"}], 
            "\[RightDoubleBracket]"}]], 
          SuperscriptBox["v", 
           RowBox[{"character", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j", ",", "1", ",", "2", ",", "1"}], 
            "\[RightDoubleBracket]"}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"Length", "[", "character", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", 
            RowBox[{
            "character", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"sfermlist", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", 
          RowBox[{
           RowBox[{"Head", "[", 
            RowBox[{"character", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
           "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
          SuperscriptBox["z", 
           RowBox[{"-", 
            RowBox[{"character", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j", ",", "1", ",", "1", ",", "1"}], 
             "\[RightDoubleBracket]"}]}]], 
          SuperscriptBox["v", 
           RowBox[{"-", 
            RowBox[{"character", "\[LeftDoubleBracket]", 
             RowBox[{"i", ",", "j", ",", "1", ",", "2", ",", "1"}], 
             "\[RightDoubleBracket]"}]}]]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", 
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"IntegerQ", "[", "lev", "]"}], "||", 
               RowBox[{"MemberQ", "[", 
                RowBox[{"mparam", ",", "0"}], "]"}]}], ")"}], ",", "2", ",", 
             "1"}], "]"}], ",", 
           RowBox[{"Length", "[", "character", "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", 
           RowBox[{"Length", "[", 
            RowBox[{
            "character", "\[LeftDoubleBracket]", "i", 
             "\[RightDoubleBracket]"}], "]"}]}], "}"}]}], "]"}]}], "/.", " ", 
      RowBox[{
       RowBox[{"MatrixRank", "[", 
        RowBox[{"{", "}"}], "]"}], "\[Rule]", "0"}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.8148578641237373`*^9, 3.814857903247622*^9}, {
  3.814857945182603*^9, 3.8148580163643208`*^9}, {3.814858048035671*^9, 
