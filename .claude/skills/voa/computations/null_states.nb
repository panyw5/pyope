Cell[BoxData[
 RowBox[{"modstart", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"EvenQ", "[", 
     RowBox[{"Length", "[", "mparam", "]"}], "]"}], ",", 
    RowBox[{
     RowBox[{"Length", "[", "mparam", "]"}], "/", "2"}], ",", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Length", "[", "mparam", "]"}], "-", "1"}], ")"}], "/", "2"}],
      "+", "1"}]}], "]"}]}]], "Input",
