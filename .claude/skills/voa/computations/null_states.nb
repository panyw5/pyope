             RowBox[{"y", ",", 
              RowBox[{
              "p", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], 
             "]"}], "+", "1"}], ")"}]}], ",", 
         RowBox[{"j", "++"}], ",", 
         RowBox[{"list", "=", 
          RowBox[{"Append", "[", 
           RowBox[{"list", ",", 
            RowBox[{"Head", "[", 
             RowBox[{
