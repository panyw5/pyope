  RowBox[{"Module", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"y", "=", "x"}], ",", "chart", ",", "chartable"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"chart", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"MemberQ", "[", 
               RowBox[{
                RowBox[{"rcounter", "[", 
                 RowBox[{"y", "\[LeftDoubleBracket]", 
                  RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
                ",", "k"}], "]"}], ",", 
              RowBox[{"RSingleCharCalculator", "[", 
               RowBox[{
                RowBox[{"RedRemover", "[", 
                 RowBox[{"y", ",", "i", ",", "j"}], "]"}], ",", "i", ",", 
                "k"}], "]"}], ",", "Nothing"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", 
              RowBox[{"Min", "[", 
               RowBox[{"rcounter", "[", 
                RowBox[{"y", "\[LeftDoubleBracket]", 
                 RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}], 
               "]"}], ",", 
              RowBox[{"Max", "[", 
               RowBox[{"rcounter", "[", 
