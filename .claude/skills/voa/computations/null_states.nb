Cell["\<\
The bold number is the degeneracy; inside the square brackets are the quantum \
numbers: red is for m (gl(1) in osp(2|2)), while blue is for r (outer \
automorphism) and black is for R (R-filtration).\
\>", "Text",
 CellChangeTimes->{{3.801917426301194*^9, 3.8019175186351423`*^9}, {
   3.814859728442419*^9, 3.81485976771483*^9}, 3.817013787439929*^9, 
   3.821883238383274*^9},ExpressionUUID->"689966b1-1bc6-48ba-86b1-\
a741b2dc675e"],

Cell[BoxData[
 RowBox[{"rfcharacter", "=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"fcal", "===", 
     CheckboxBox[False]}], ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"fermlist", "\[LeftDoubleBracket]", 
         RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", " ", 
        RowBox[{
         RowBox[{"Head", "[", 
          RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "k"}], "\[RightDoubleBracket]"}], 
          "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
        SuperscriptBox["z", 
         RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "1", ",", "1"}], 
          "\[RightDoubleBracket]"}]], 
        SuperscriptBox["y", 
         RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "3"}], 
          "\[RightDoubleBracket]"}]], 
        SuperscriptBox["v", 
         RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "2", ",", "1"}], 
          "\[RightDoubleBracket]"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "rcharacter", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", 
         RowBox[{"Length", "[", 
          RowBox[{
          "rcharacter", "\[LeftDoubleBracket]", "i", 
           "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}]}], 
        "}"}]}], "]"}], "]"}], ",", 
    RowBox[{"Quiet", "[", 
     RowBox[{
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sfermlist", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", 
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j", ",", "k"}], "\[RightDoubleBracket]"}], 
           "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
         SuperscriptBox["z", 
          RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "1", ",", "1"}], 
           "\[RightDoubleBracket]"}]], 
         SuperscriptBox["y", 
          RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "3"}], 
           "\[RightDoubleBracket]"}]], 
         SuperscriptBox["v", 
          RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "2", ",", "1"}], 
           "\[RightDoubleBracket]"}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "rcharacter", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", 
           RowBox[{
           "rcharacter", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}]}], 
         "}"}]}], "]"}], "+", 
      RowBox[{"Sum", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"sfermlist", "\[LeftDoubleBracket]", 
          RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "*", 
         RowBox[{
          RowBox[{"Head", "[", 
           RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j", ",", "k"}], "\[RightDoubleBracket]"}], 
           "]"}], "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], " ", 
         SuperscriptBox["z", 
          RowBox[{"-", 
           RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "1", ",", "1"}], 
            "\[RightDoubleBracket]"}]}]], 
         SuperscriptBox["y", 
          RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
           RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "3"}], 
           "\[RightDoubleBracket]"}]], 
         SuperscriptBox["v", 
          RowBox[{"-", 
           RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j", ",", "k", ",", "1", ",", "2", ",", "1"}], 
            "\[RightDoubleBracket]"}]}]]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"IntegerQ", "[", "lev", "]"}], "||", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"mparam", ",", "0"}], "]"}]}], ")"}], ",", "2", ",", 
            "1"}], "]"}], ",", 
          RowBox[{"Length", "[", "rcharacter", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", 
          RowBox[{"Length", "[", 
           RowBox[{
           "rcharacter", "\[LeftDoubleBracket]", "i", 
            "\[RightDoubleBracket]"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", 
          RowBox[{"Length", "[", 
           RowBox[{"rcharacter", "\[LeftDoubleBracket]", 
            RowBox[{"i", ",", "j"}], "\[RightDoubleBracket]"}], "]"}]}], 
         "}"}]}], "]"}]}], "]"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.8148578641237373`*^9, 3.814857903247622*^9}, {
   3.814857945182603*^9, 3.8148580163643208`*^9}, {3.814858048035671*^9, 
   3.81485809420168*^9}, {3.814858687848708*^9, 3.814858709125781*^9}, {
